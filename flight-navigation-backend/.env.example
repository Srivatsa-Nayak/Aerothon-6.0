# Copy to .env and fill in. .env is git-ignored; never commit real values.
PORT=5000

# true = answer every third-party API call (weather, airports, fuel) with demo data
# from ./mocks, so no API keys are needed. Set to false to use the real APIs below.
MOCK_EXTERNAL_APIS=true

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=airbus

# https://www.weatherapi.com/ (current conditions)
WEATHER_API_KEY=

# https://developers.amadeus.com/ (self-service app, test environment).
# Preferred: client ID + secret; the server fetches and refreshes tokens itself.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
# Fallback: a static access token (expires after ~30 minutes)
AMADEUS_API_KEY=

# https://rapidapi.com/Active-api/api/airport-info (airport coordinates by IATA)
RAPIDAPI_KEY=
